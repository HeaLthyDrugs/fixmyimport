---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import LanguagePicker from "@/components/language-picker.astro"
import SiteFooter from "@/components/site-footer.astro"
import { type Lang } from "@/i18n/ui"
import { useTranslations, useTranslatedPath } from "@/i18n/utils"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<Layout
  lang={lang}
  title={t("shopify.seoTitle")}
  description={t("shopify.seoDesc")}
>
  <main class="w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl p-6 sm:p-8">
      <div class="mb-6 flex items-center justify-between">
        <a
          href={translatePath("/")}
          class="group inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          <span class="transition-transform group-hover:-translate-x-0.5">&larr;</span>
          <img
            src="/logo/logo.png"
            alt="FixMyImport"
            width="20"
            height="20"
            class="size-5 object-contain"
          />
          <span class="font-heading font-semibold text-foreground">FixMyImport</span>
        </a>
        <LanguagePicker currentLang={lang} variant="select" />
      </div>

      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p
            class="font-sans text-xs font-semibold tracking-widest text-muted-foreground uppercase"
          >
            {t("shopify.badge")}
          </p>
          <h1
            class="font-heading text-3xl leading-tight font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl"
          >
            {t("shopify.title")}
          </h1>
          <p
            class="max-w-2xl font-editorial text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            {t("shopify.desc")}
          </p>
        </div>
        <div class="grid gap-4">
          <div class="border border-border/70 bg-background/70 p-4">
            <h2
              class="font-heading text-base font-semibold tracking-tight text-foreground"
            >
              {t("shopify.card1.title")}
            </h2>
            <p
              class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground"
            >
              {t("shopify.card1.desc")}
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2
              class="font-heading text-base font-semibold tracking-tight text-foreground"
            >
              {t("shopify.card2.title")}
            </h2>
            <p
              class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground"
            >
              {t("shopify.card2.desc")}
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2
              class="font-heading text-base font-semibold tracking-tight text-foreground"
            >
              {t("shopify.card3.title")}
            </h2>
            <p
              class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground"
            >
              {t("shopify.card3.desc")}
            </p>
          </div>
        </div>
        <Button asChild>
          <a href={translatePath("/tools/csv-import-cleaner")}>
            {t("shopify.button")}
          </a>
        </Button>
      </div>

      <SiteFooter lang={lang} className="mt-16" />
    </div>
  </main>
</Layout>

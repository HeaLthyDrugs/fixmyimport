---
import { BinaryConverter } from "@/components/binary-converter"
import Layout from "@/layouts/main.astro"
import { getLocalizedTool } from "@/i18n/tools"
import type { Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const tool = getLocalizedTool("binary-to-text", lang)

if (!tool) {
  throw new Error("Binary to Text tool metadata is missing.")
}
---

<Layout lang={lang} title={tool.seoTitle} description={tool.seoDescription}>
  <BinaryConverter client:load />
</Layout>


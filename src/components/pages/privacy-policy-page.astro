---
import Layout from "@/layouts/main.astro"
import SiteNavbar from "@/components/site-navbar.astro"
import SiteFooter from "@/components/site-footer.astro"
import { type Lang } from "@/i18n/ui"
import { useTranslatedPath } from "@/i18n/utils"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const translatePath = useTranslatedPath(lang)
---

<Layout
  lang={lang}
  title="Privacy Policy | FixMyImport"
  description="Transparent overview of how FixMyImport processes CSV files locally in your browser with zero server uploads, no accounts, and strict privacy protection."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground">
    <SiteNavbar lang={lang} />
    <main
      class="mx-auto w-full max-w-4xl flex-1 px-4 pt-6 pb-12 sm:px-6 sm:pt-8 sm:pb-16 lg:px-8"
    >
      <!-- Header -->
      <div class="mt-4 space-y-1.5">
        <h1
          class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl lg:text-4xl"
        >
          Privacy Policy
        </h1>
        <p class="text-xs text-muted-foreground">Last updated: 2026</p>
      </div>

      <!-- Content Sections -->
      <article
        class="mt-8 space-y-10 font-editorial text-base leading-relaxed text-muted-foreground"
      >
        <!-- Overview -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            Overview
          </h2>
          <p>
            FixMyImport ("we", "our", "service"), accessible at{" "}
            <a
              href={translatePath("/")}
              class="text-foreground underline underline-offset-4 transition-colors hover:text-foreground/80"
            >
              fixmyimport.com
            </a>
            , is committed to protecting your privacy. This policy clearly and transparently
            explains how we handle information in accordance with the LGPD (Brazilian
            General Data Protection Law - Law No. 13.709/2018), GDPR (General Data
            Protection Regulation of the European Union), and CCPA (California Consumer
            Privacy Act).
          </p>
          <p class="font-medium text-foreground">
            In short: we do not collect, store, sell, or share your personal
            data or uploaded file contents.
          </p>
        </section>

        <!-- 1. Zero-Upload Architecture & Information We Collect -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            1. Information We Collect
          </h2>
          <p>
            <strong class="font-semibold text-foreground">
              You don't need to create an account, log in, or provide any
              personal information to use FixMyImport.
            </strong>
          </p>
          <p>
            The CSV tools and utilities work 100% within your device's browser.
            Any file parsing, data cleaning, format conversion, and batch
            splitting are executed solely in memory using browser-native Web
            Workers. Your files, column headers, and spreadsheet rows are never
            sent to our servers.
          </p>
          <p>
            We may collect anonymous and aggregated technical data through
            standard server logs and statistical analysis tools:
          </p>
          <ul
            class="list-disc space-y-2 pl-5 font-editorial text-sm leading-relaxed text-muted-foreground sm:text-base"
          >
            <li>Pages visited and approximate time spent on the site.</li>
            <li>Browser type and operating system (aggregate statistics).</li>
            <li>Originating website or search engine referral.</li>
            <li>
              Country or approximate geographic region (without exact
              geolocation).
            </li>
          </ul>
        </section>

        <!-- 2. Cookies and Local Storage -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            2. Cookies and Local Storage
          </h2>
          <p>
            FixMyImport does not use invasive cross-site tracking cookies. We
            use the{" "}
            <code
              class="rounded-xs bg-muted/60 px-1.5 py-0.5 font-mono text-xs text-foreground"
              >localStorage</code
            >{" "}
            feature exclusively to remember your visual theme preference (dark or
            light mode) and local tool preferences between sessions. This data remains
            solely in your device's memory.
          </p>
          <p>
            You can delete this data at any time by clearing the browsing data
            for fixmyimport.com in your browser settings.
          </p>
        </section>

        <!-- 3. Third-Party Services -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            3. Third-Party Services and Infrastructure
          </h2>
          <p>
            We use Google Fonts for optimized typography loading. When loading
            fonts, assets are delivered in accordance with standard CDN asset
            delivery policies. We do not embed invasive third-party tracking
            scripts or advertising networks that profile user browsing habits.
          </p>
        </section>

        <!-- 4. Data Retention and Security -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            4. Data Retention and Security
          </h2>
          <p>
            Since we do not store registration data or individual spreadsheet
            files, the security of your data is guaranteed by your browser's own
            standard process isolation and sandboxing. Closing your tab or
            browser immediately clears all parsed data from memory. Anonymous
            technical server access logs are discarded periodically.
          </p>
        </section>

        <!-- 5. Your Rights (LGPD and GDPR) -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            5. Your Rights (LGPD and GDPR)
          </h2>
          <p>
            In accordance with applicable legislation, users have the right to
            confirm the existence of data processing, request clarification, or
            request the deletion of any information that may be stored. As our
            service operates anonymously and without registration, almost no
            personal data is retained.
          </p>
          <p>
            If you wish to exercise any of your rights or have any questions
            about privacy, please contact us through our{" "}
            <a
              href={translatePath("/contact")}
              class="text-foreground underline underline-offset-4 transition-colors hover:text-foreground/80"
            >
              contact page
            </a>
            .
          </p>
        </section>

        <!-- 6. Changes to This Policy -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            6. Changes to This Policy
          </h2>
          <p>
            We may update this Privacy Policy periodically to reflect service
            improvements or legal requirements. The last updated date at the top
            of this page will always indicate the current version.
          </p>
        </section>

        <!-- 7. Contact -->
        <section class="space-y-3">
          <h2
            class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl"
          >
            7. Contact
          </h2>
          <p>
            Questions or requests regarding this Privacy Policy?{" "}
            <a
              href={translatePath("/contact")}
              class="text-foreground underline underline-offset-4 transition-colors hover:text-foreground/80"
            >
              Contact us here
            </a>{" "}
            or write directly to{" "}
            <a
              href="mailto:contact@fixmyimport.com"
              class="text-foreground underline underline-offset-4 transition-colors hover:text-foreground/80"
            >
              contact@fixmyimport.com
            </a>
            .
          </p>
        </section>
      </article>
    </main>

    <SiteFooter lang={lang} />
  </div>
</Layout>

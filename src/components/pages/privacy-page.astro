---
import Layout from "@/layouts/main.astro"
import SiteNavbar from "@/components/site-navbar.astro"
import LanguagePicker from "@/components/language-picker.astro"
import { type Lang } from "@/i18n/ui"
import { useTranslations, useTranslatedPath } from "@/i18n/utils"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<Layout
  lang={lang}
  title={t("privacy.seoTitle")}
  description={t("privacy.seoDesc")}
>
  <SiteNavbar lang={lang} />
  <main class="w-full px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <div class="mx-auto max-w-6xl p-4 sm:p-6">
      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p
            class="font-sans text-xs font-semibold tracking-widest text-muted-foreground uppercase"
          >
            {t("privacy.badge")}
          </p>
          <h1
            class="font-heading text-3xl leading-tight font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl"
          >
            {t("privacy.title")}
          </h1>
          <p
            class="max-w-2xl font-editorial text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            {t("privacy.desc")}
          </p>
        </div>
        <div class="grid gap-4">
          <div class="border border-border/70 bg-background/70 p-4">
            <h2
              class="font-heading text-base font-semibold tracking-tight text-foreground"
            >
              {t("privacy.card1.title")}
            </h2>
            <p
              class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground"
            >
              {t("privacy.card1.desc")}
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2
              class="font-heading text-base font-semibold tracking-tight text-foreground"
            >
              {t("privacy.card2.title")}
            </h2>
            <p
              class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground"
            >
              {t("privacy.card2.desc")}
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2
              class="font-heading text-base font-semibold tracking-tight text-foreground"
            >
              {t("privacy.card3.title")}
            </h2>
            <p
              class="mt-2 font-editorial text-sm leading-relaxed text-muted-foreground"
            >
              {t("privacy.card3.desc")}
            </p>
          </div>
        </div>
      </div>

      <footer class="mt-16 border-t border-border/80 pt-8">
        <div
          class="flex flex-col items-center justify-between gap-4 text-sm text-muted-foreground sm:flex-row"
        >
          <p>
            &copy; {new Date().getFullYear()} FixMyImport. {t("footer.tagline")}
          </p>
          <div class="flex items-center gap-4">
            <a
              href={translatePath("/shopify-csv-cleaner")}
              class="transition-colors hover:text-foreground"
            >
              {t("footer.shopify")}
            </a>
            <span>&bull;</span>
            <a
              href={translatePath("/mailchimp-csv-too-large")}
              class="transition-colors hover:text-foreground"
            >
              {t("footer.mailchimp")}
            </a>
          </div>
        </div>
        <div class="mt-4 border-t border-border/50 pt-4">
          <LanguagePicker currentLang={lang} variant="list" />
        </div>
      </footer>
    </div>
  </main>
</Layout>

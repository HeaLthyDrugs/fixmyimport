---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import LanguagePicker from "@/components/language-picker.astro"
import { getLocalizedTool, getLocalizedToolDetail } from "@/i18n/tools"
import { useTranslations, useTranslatedPath } from "@/i18n/utils"
import type { Lang } from "@/i18n/ui"

interface Props {
  toolId: string
  lang: Lang
}

const { toolId, lang } = Astro.props
const tool = getLocalizedTool(toolId, lang)
const detail = getLocalizedToolDetail(toolId, lang)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

if (!tool) {
  throw new Error(`Tool metadata for "${toolId}" is missing.`)
}
---

<Layout lang={lang} title={tool.seoTitle} description={tool.seoDescription}>
  <main class="w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl p-6 sm:p-8">
      <div class="mb-6 flex items-center justify-between">
        <a
          href={translatePath("/")}
          class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          &larr; FixMyImport
        </a>
        <LanguagePicker currentLang={lang} variant="select" />
      </div>

      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p class="text-base font-medium tracking-wider text-muted-foreground uppercase">
            {t("badge.comingSoon")}
          </p>
          <h1
            class="text-3xl leading-tight font-semibold tracking-wide sm:text-4xl lg:text-5xl"
          >
            {detail?.h1 || tool.name}
          </h1>
          <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
            {detail?.lead || tool.description}
          </p>
        </div>

        {
          detail?.cards && detail.cards.length > 0 && (
            <div class="grid gap-4 text-base text-muted-foreground">
              {detail.cards.map((card) => (
                <div class="border border-border/70 bg-background/70 p-4">
                  <h2 class="text-lg font-semibold tracking-wide text-foreground">
                    {card.title}
                  </h2>
                  <p class="mt-2 leading-relaxed">{card.desc}</p>
                </div>
              ))}
            </div>
          )
        }

        <Button asChild>
          <a href={translatePath("/tools/csv-import-cleaner")}>
            {t("btn.tryCleaner")}
          </a>
        </Button>
      </div>

      <footer class="mt-16 border-t border-border/80 pt-8">
        <div class="flex flex-col items-center justify-between gap-4 text-sm text-muted-foreground sm:flex-row">
          <p>&copy; {new Date().getFullYear()} FixMyImport. {t("footer.tagline")}</p>
          <div class="flex items-center gap-4">
            <a href={translatePath("/privacy")} class="transition-colors hover:text-foreground">
              {t("footer.privacy")}
            </a>
            <span>&bull;</span>
            <a href={translatePath("/shopify-csv-cleaner")} class="transition-colors hover:text-foreground">
              {t("footer.shopify")}
            </a>
            <span>&bull;</span>
            <a href={translatePath("/mailchimp-csv-too-large")} class="transition-colors hover:text-foreground">
              {t("footer.mailchimp")}
            </a>
          </div>
        </div>
        <div class="mt-4 border-t border-border/50 pt-4">
          <LanguagePicker currentLang={lang} variant="list" />
        </div>
      </footer>
    </div>
  </main>
</Layout>

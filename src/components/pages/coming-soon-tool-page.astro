---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import LanguagePicker from "@/components/language-picker.astro"
import SiteFooter from "@/components/site-footer.astro"
import ToolSeoSection from "@/components/seo/tool-seo-section.astro"
import { getLocalizedTool, getLocalizedToolDetail } from "@/i18n/tools"
import { useTranslations, useTranslatedPath } from "@/i18n/utils"
import type { Lang } from "@/i18n/ui"

interface Props {
  toolId: string
  lang: Lang
}

const { toolId, lang } = Astro.props
const tool = getLocalizedTool(toolId, lang)
const detail = getLocalizedToolDetail(toolId, lang)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

if (!tool) {
  throw new Error(`Tool metadata for "${toolId}" is missing.`)
}
---

<Layout lang={lang} title={tool.seoTitle} description={tool.seoDescription}>
  <main class="w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl p-6 sm:p-8">
      <div class="mb-6 flex items-center justify-between">
        <a
          href={translatePath("/")}
          class="group inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          <span class="transition-transform group-hover:-translate-x-0.5">&larr;</span>
          <img
            src="/logo/logo.png"
            alt="FixMyImport"
            width="20"
            height="20"
            class="size-5 object-contain"
          />
          <span class="font-heading font-semibold text-foreground">FixMyImport</span>
        </a>
        <LanguagePicker currentLang={lang} variant="select" />
      </div>

      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p
            class="font-sans text-xs font-semibold tracking-widest text-muted-foreground uppercase"
          >
            {t("badge.comingSoon")}
          </p>
          <h1
            class="font-heading text-2xl leading-tight font-bold tracking-tight text-foreground sm:text-3xl lg:text-4xl"
          >
            {detail?.h1 || tool.name}
          </h1>
          <p
            class="max-w-2xl font-editorial text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            {detail?.lead || tool.description}
          </p>
        </div>

        {
          detail?.cards && detail.cards.length > 0 && (
            <div class="space-y-3 font-editorial text-sm leading-relaxed text-muted-foreground">
              {detail.cards.map((card) => (
                <p>
                  <strong class="font-heading font-semibold tracking-tight text-foreground">
                    {card.title}
                  </strong>
                  {" — "}
                  <span>{card.desc}</span>
                </p>
              ))}
            </div>
          )
        }

        <div class="flex flex-wrap items-center gap-4 pt-1">
          <Button asChild>
            <a href={translatePath("/tools/csv-import-cleaner")}>
              {t("btn.tryCleaner")}
            </a>
          </Button>
          <a
            href="#tool-details"
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground transition hover:text-foreground"
          >
            <span>Read specifications &amp; FAQs</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      {/* SEO Deep Details & Reference Section */}
      <div class="mt-12">
        <ToolSeoSection toolId={toolId} lang={lang} />
      </div>

      <SiteFooter lang={lang} className="mt-16" />
    </div>
  </main>
</Layout>

---
import { RiArrowRightUpLine } from "@remixicon/react"

import Layout from "@/layouts/main.astro"
import ToolIcon from "@/components/tool-icon.astro"
import SiteNavbar from "@/components/site-navbar.astro"
import SiteFooter from "@/components/site-footer.astro"
import HomeSeoSection from "@/components/seo/home-seo-section.astro"
import { type Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"
import { getLocalizedCatalog } from "@/i18n/tools"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const localizedCatalog = getLocalizedCatalog(lang)
const csvTools = localizedCatalog.filter((item) => item.category === "csv")
const utilityTools = localizedCatalog.filter(
  (item) => item.category === "utilities"
)
---

<Layout lang={lang} title={t("site.title")} description={t("site.description")}>
  <SiteNavbar lang={lang} />
  <main class="min-h-screen px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-12">
      {/* Hero Header */}
      <header class="pt-2 pb-2">
        <div class="space-y-2">
          <h1
            class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl lg:text-4xl"
          >
            {t("hero.title")}
          </h1>
          <p
            class="max-w-2xl font-editorial text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            {t("hero.subtitle")}
          </p>
        </div>
      </header>

      {/* SECTION 1: CSV & Data Import Tools */}
      <section class="space-y-4">
        <h2
          class="font-heading text-xl font-semibold tracking-tight text-foreground sm:text-2xl"
        >
          {t("section.csv")}
        </h2>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            csvTools.map((tool) => {
              const isLive = tool.status === "Live"
              const Component = isLive ? "a" : "div"

              return (
                <Component
                  href={isLive ? tool.href : undefined}
                  class={`group flex flex-col justify-start border border-border/80 bg-card p-5 shadow-xs transition-all duration-200 ${
                    isLive
                      ? "cursor-pointer hover:-translate-y-0.5 hover:border-foreground/30 hover:shadow-sm"
                      : "cursor-default opacity-60"
                  }`}
                >
                  <div class="mb-3.5 flex items-start justify-between gap-3">
                    <div class="flex size-10 items-center justify-center border border-border/80 bg-muted/40 text-foreground transition-colors group-hover:border-foreground/30 group-hover:bg-muted/70">
                      <ToolIcon name={tool.icon} className="size-5" />
                    </div>
                    {isLive && (
                      <RiArrowRightUpLine className="size-4 text-muted-foreground/60 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground" />
                    )}
                  </div>

                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between gap-2">
                      <h3 class="font-heading text-base font-semibold tracking-tight text-foreground transition-colors group-hover:text-foreground">
                        {tool.name}
                      </h3>
                      {!isLive && (
                        <span class="rounded-xs border border-border/80 bg-muted/60 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground uppercase">
                          {t("badge.comingSoon")}
                        </span>
                      )}
                    </div>
                    <p class="font-editorial text-sm leading-relaxed text-muted-foreground">
                      {tool.description}
                    </p>
                  </div>
                </Component>
              )
            })
          }
        </div>
      </section>

      {/* SECTION 2: Developer & Everyday Utilities */}
      <section class="space-y-4">
        <h2
          class="font-heading text-xl font-semibold tracking-tight text-foreground sm:text-2xl"
        >
          {t("section.utilities")}
        </h2>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            utilityTools.map((tool) => {
              const isLive = tool.status === "Live"
              const Component = isLive ? "a" : "div"

              return (
                <Component
                  href={isLive ? tool.href : undefined}
                  class={`group flex flex-col justify-start border border-border/80 bg-card p-5 shadow-xs transition-all duration-200 ${
                    isLive
                      ? "cursor-pointer hover:-translate-y-0.5 hover:border-foreground/30 hover:shadow-sm"
                      : "cursor-default opacity-60"
                  }`}
                >
                  <div class="mb-3.5 flex items-start justify-between gap-3">
                    <div class="flex size-10 items-center justify-center border border-border/80 bg-muted/40 text-foreground transition-colors group-hover:border-foreground/30 group-hover:bg-muted/70">
                      <ToolIcon name={tool.icon} className="size-5" />
                    </div>
                    {isLive && (
                      <RiArrowRightUpLine className="size-4 text-muted-foreground/60 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground" />
                    )}
                  </div>

                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between gap-2">
                      <h3 class="font-heading text-base font-semibold tracking-tight text-foreground transition-colors group-hover:text-foreground">
                        {tool.name}
                      </h3>
                      {!isLive && (
                        <span class="rounded-xs border border-border/80 bg-muted/60 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground uppercase">
                          {t("badge.comingSoon")}
                        </span>
                      )}
                    </div>
                    <p class="font-editorial text-sm leading-relaxed text-muted-foreground">
                      {tool.description}
                    </p>
                  </div>
                </Component>
              )
            })
          }
        </div>
      </section>

      {/* SEO Educational & Details Section */}
      <HomeSeoSection lang={lang} />

      {/* Footer */}
      <SiteFooter lang={lang} className="pt-6" maxWidth="max-w-4xl" />
    </div>
  </main>
</Layout>

---
import SiteNavbar from "@/components/site-navbar.astro"
import { type Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
  backLabel?: string
  backHref?: string
  className?: string
  maxWidth?: string
}

const { lang, className = "", maxWidth = "" } = Astro.props
---

<SiteNavbar lang={lang} className={className} maxWidth={maxWidth} />

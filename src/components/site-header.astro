---
import { RiSunLine, RiMoonLine } from "@remixicon/react"
import LanguagePicker from "@/components/language-picker.astro"
import { type Lang } from "@/i18n/ui"
import { useTranslations, useTranslatedPath } from "@/i18n/utils"

interface Props {
  lang: Lang
  backLabel?: string
  backHref?: string
  className?: string
}

const { lang, backLabel, backHref, className = "" } = Astro.props

const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

const targetBackHref = backHref || translatePath("/")
const targetBackLabel = backLabel || t("header.backToTools")
---

<nav
  aria-label="Top navigation"
  class={`flex w-full items-center justify-between ${className}`}
>
  <!-- Minimal Back Text Button -->
  <a
    href={targetBackHref}
    class="group inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
  >
    <span class="transition-transform duration-150 group-hover:-translate-x-0.5"
      >&larr;</span
    >
    <span>{targetBackLabel}</span>
  </a>

  <!-- Minimal Right Controls (Cleaner link, Theme, Language) separated by dots -->
  <div class="flex items-center gap-2.5 text-xs text-muted-foreground">
    <a
      href={translatePath("/tools/csv-import-cleaner")}
      class="font-medium transition-colors hover:text-foreground"
    >
      {t("header.openCleaner")}
    </a>

    <span class="text-muted-foreground/40" aria-hidden="true">&bull;</span>

    <!-- Theme Toggle Text/Icon Button -->
    <button
      type="button"
      id="theme-toggle-btn"
      class="inline-flex cursor-pointer items-center justify-center text-muted-foreground transition-colors hover:text-foreground"
      aria-label={t("header.toggleTheme")}
      title={t("header.toggleTheme")}
    >
      <RiSunLine className="hidden size-3.5 dark:block" />
      <RiMoonLine className="block size-3.5 dark:hidden" />
    </button>

    <span class="text-muted-foreground/40" aria-hidden="true">&bull;</span>

    <!-- Minimal Language Picker -->
    <LanguagePicker currentLang={lang} variant="minimal" />
  </div>
</nav>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle-btn")
    if (!btn) return

    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark")
      if (isDark) {
        document.documentElement.classList.remove("dark")
        localStorage.setItem("theme", "light")
      } else {
        document.documentElement.classList.add("dark")
        localStorage.setItem("theme", "dark")
      }
    })
  }

  setupThemeToggle()
  document.addEventListener("astro:after-swap", setupThemeToggle)
</script>

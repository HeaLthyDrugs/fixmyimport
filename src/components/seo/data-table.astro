---
import type { SeoTable } from "@/data/seo-content/types"

interface Props {
  table: SeoTable
}

const { table } = Astro.props
---

<div class="space-y-3">
  {
    table.title && (
      <h2 class="text-lg font-semibold tracking-tight text-foreground sm:text-xl">
        {table.title}
      </h2>
    )
  }

  {
    table.description && (
      <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm">
        {table.description}
      </p>
    )
  }

  <div class="overflow-x-auto rounded-md border border-border/40 bg-card/30">
    <table class="w-full text-left text-xs sm:text-[13px]">
      <thead
        class="border-b border-border/40 bg-muted/20 text-[11px] font-medium tracking-wider text-muted-foreground uppercase"
      >
        <tr>
          {
            table.headers.map((header) => (
              <th scope="col" class="px-3.5 py-2.5 sm:px-4">
                {header}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-y divide-border/20">
        {
          table.rows.map((row) => (
            <tr class="transition-colors hover:bg-muted/20">
              {row.map((cell, cellIndex) => (
                <td
                  class={`px-3.5 py-2.5 sm:px-4 ${
                    cellIndex === 0
                      ? "font-medium text-foreground"
                      : "text-muted-foreground"
                  }`}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

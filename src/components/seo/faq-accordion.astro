---
import type { SeoFaq } from "@/data/seo-content/types"

interface Props {
  faqs: SeoFaq[]
  title?: string
}

const { faqs, title = "Frequently Asked Questions" } = Astro.props
---

<div class="space-y-4">
  <h2 class="text-lg font-semibold tracking-tight text-foreground sm:text-xl">
    {title}
  </h2>

  <div class="space-y-2">
    {
      faqs.map((faq) => (
        <details class="group rounded-md border border-border/40 bg-card/40 p-3.5 transition-colors sm:p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-3 text-left font-medium text-foreground transition-colors hover:text-foreground/80 focus:outline-hidden">
            <span class="text-sm font-medium tracking-normal text-foreground sm:text-[15px]">
              {faq.question}
            </span>
            <span class="ml-3 shrink-0 transition-transform duration-200 group-open:rotate-180">
              <svg
                class="size-3.5 text-muted-foreground transition-colors group-hover:text-foreground"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </span>
          </summary>
          <div class="mt-2.5 text-xs leading-relaxed text-muted-foreground sm:text-sm">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

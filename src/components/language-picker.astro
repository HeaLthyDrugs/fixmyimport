---
import { languages, type Lang } from "@/i18n/ui"
import { getLangFromUrl, useTranslatedPath, getCleanPath } from "@/i18n/utils"
import { RiGlobalLine } from "@remixicon/react"

interface Props {
  currentLang?: Lang
  className?: string
  variant?: "select" | "list" | "minimal" | "navbar" | "icon"
}

const {
  currentLang = getLangFromUrl(Astro.url),
  className = "",
  variant = "select",
} = Astro.props

const cleanPath = getCleanPath(Astro.url.pathname)
const translatePath = useTranslatedPath(currentLang)
---

{
  variant === "icon" ? (
    <div
      class={`relative inline-flex items-center justify-center text-muted-foreground transition-colors hover:text-foreground ${className}`}
      title="Select language"
    >
      <label for="language-select-icon" class="sr-only">
        Select language
      </label>
      <RiGlobalLine className="pointer-events-none size-4" />
      <select
        id="language-select-icon"
        aria-label="Select language"
        data-language-picker
        class="absolute inset-0 size-full cursor-pointer opacity-0"
      >
        {Object.entries(languages).map(([code, label]) => {
          const l = code as Lang
          const targetUrl = translatePath(cleanPath, l)
          return (
            <option
              value={targetUrl}
              selected={l === currentLang}
              class="bg-background py-1 text-foreground"
            >
              {label} ({code.toUpperCase()})
            </option>
          )
        })}
      </select>
    </div>
  ) : variant === "navbar" ? (
    <div class={`relative inline-flex items-center ${className}`}>
      <label for="language-select-navbar" class="sr-only">
        Language
      </label>
      <div class="pointer-events-none absolute left-2.5 flex items-center text-muted-foreground">
        <RiGlobalLine className="size-3.5" />
      </div>
      <select
        id="language-select-navbar"
        aria-label="Select language"
        data-language-picker
        class="h-8 cursor-pointer appearance-none rounded-2xl border border-border/80 bg-background/60 pr-6 pl-7.5 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:bg-muted/50 hover:text-foreground focus:border-foreground/40 focus:outline-hidden"
      >
        {Object.entries(languages).map(([code, label]) => {
          const l = code as Lang
          const targetUrl = translatePath(cleanPath, l)
          return (
            <option
              value={targetUrl}
              selected={l === currentLang}
              class="bg-background py-1 text-foreground"
            >
              {code.toUpperCase()} &bull; {label}
            </option>
          )
        })}
      </select>
      <span class="pointer-events-none absolute right-2 text-[9px] text-muted-foreground/70">
        &#9662;
      </span>
    </div>
  ) : variant === "minimal" ? (
    <div class={`relative inline-flex items-center ${className}`}>
      <label for="language-select-minimal" class="sr-only">
        Language
      </label>
      <select
        id="language-select-minimal"
        aria-label="Select language"
        data-language-picker
        class="cursor-pointer appearance-none bg-transparent pr-3 pl-0 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground focus:outline-hidden"
      >
        {Object.entries(languages).map(([code, label]) => {
          const l = code as Lang
          const targetUrl = translatePath(cleanPath, l)
          return (
            <option
              value={targetUrl}
              selected={l === currentLang}
              class="bg-background text-foreground"
            >
              {label}
            </option>
          )
        })}
      </select>
      <span class="pointer-events-none absolute right-0 text-[9px] text-muted-foreground/60">
        ▾
      </span>
    </div>
  ) : variant === "select" ? (
    <div class={`relative inline-flex items-center gap-1.5 ${className}`}>
      <label for="language-select" class="sr-only">
        Language
      </label>
      <RiGlobalLine className="pointer-events-none size-4 text-muted-foreground" />
      <select
        aria-label="Select language"
        data-language-picker
        onchange="if (this.value) window.location.href = this.value"
        class="cursor-pointer appearance-none rounded-xl border border-border bg-muted/40 py-1 pr-6 pl-2 text-xs font-medium tracking-wide text-foreground transition-colors hover:border-foreground/30 hover:bg-muted/70 focus:outline-hidden"
      >
        {Object.entries(languages).map(([code, label]) => {
          const l = code as Lang
          const targetUrl = translatePath(cleanPath, l)
          return (
            <option value={targetUrl} selected={l === currentLang}>
              {label}
            </option>
          )
        })}
      </select>
      <span class="pointer-events-none absolute right-2 text-xs text-muted-foreground">
        ▾
      </span>
    </div>
  ) : (
    <nav
      aria-label="Languages"
      class={`flex flex-wrap items-center gap-2 text-xs ${className}`}
    >
      {Object.entries(languages).map(([code, label], index) => {
        const l = code as Lang
        const isCurrent = l === currentLang
        const targetUrl = translatePath(cleanPath, l)
        return (
          <>
            {index > 0 && <span class="text-muted-foreground/50">&bull;</span>}
            <a
              href={targetUrl}
              class={`transition-colors ${
                isCurrent
                  ? "font-semibold text-foreground underline underline-offset-4"
                  : "text-muted-foreground hover:text-foreground"
              }`}
              hreflang={l}
            >
              {label}
            </a>
          </>
        )
      })}
    </nav>
  )
}

<script>
  function setupLanguagePickers() {
    document
      .querySelectorAll<HTMLSelectElement>("[data-language-picker]")
      .forEach((select) => {
        select.addEventListener("change", (event) => {
          const target = event.target as HTMLSelectElement
          if (target?.value) {
            window.location.href = target.value
          }
        })
      })
  }

  setupLanguagePickers()
  document.addEventListener("astro:after-swap", setupLanguagePickers)
</script>

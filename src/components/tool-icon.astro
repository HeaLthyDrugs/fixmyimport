---
import {
  RiFileList3Line,
  RiArrowLeftRightLine,
  RiMergeCellsHorizontal,
  RiShieldCheckLine,
  RiCodeSSlashLine,
  RiQrCodeLine,
  RiText,
  RiFileCodeLine,
  RiBracesLine,
  RiTimeLine,
  RiFingerprintLine,
} from "@remixicon/react"

import type { ToolIconName } from "@/lib/tools"

interface Props {
  name: ToolIconName
  className?: string
}

const { name, className = "size-5" } = Astro.props

const iconMap = {
  "csv-import": RiFileList3Line,
  "column-mapper": RiArrowLeftRightLine,
  "csv-merge": RiMergeCellsHorizontal,
  "import-validator": RiShieldCheckLine,
  "binary-converter": RiCodeSSlashLine,
  "text-case": RiText,
  "base64": RiFileCodeLine,
  "json-format": RiBracesLine,
  "qr-generator": RiQrCodeLine,
  "timestamp": RiTimeLine,
  "uuid-hash": RiFingerprintLine,
}

const Icon = iconMap[name] ?? RiCodeSSlashLine
---

<Icon aria-hidden="true" className={className} />

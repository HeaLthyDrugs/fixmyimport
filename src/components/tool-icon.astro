---
import {
  RiFileList3Line,
  RiArrowLeftRightLine,
  RiMergeCellsHorizontal,
  RiShieldCheckLine,
} from "@remixicon/react"

import type { ToolIconName } from "@/lib/tools"

interface Props {
  name: ToolIconName
  className?: string
}

const { name, className = "size-5" } = Astro.props

const iconMap = {
  "csv-import": RiFileList3Line,
  "column-mapper": RiArrowLeftRightLine,
  "csv-merge": RiMergeCellsHorizontal,
  "import-validator": RiShieldCheckLine,
}

const Icon = iconMap[name]
---

<Icon aria-hidden="true" className={className} />

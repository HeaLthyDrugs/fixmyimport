---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "FixMyImport | Clean browser-based tools for fixing imports",
  description = "FixMyImport is a growing set of browser-based tools for cleaning, splitting, and preparing import files without uploads or accounts.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>

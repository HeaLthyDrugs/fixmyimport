---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "FixMyImport | Clean, dedupe, and split import-ready CSVs",
  description = "Fix messy CSV exports in your browser. Clean, dedupe, split, and export import-ready files with no upload and no account.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>

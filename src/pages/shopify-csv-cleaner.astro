---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
---

<Layout
  title="Shopify CSV Cleaner | Prep imports locally with FixMyImport"
  description="Use FixMyImport to clean, dedupe, and split Shopify CSV imports locally in your browser."
>
  <main class="w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl p-6 sm:p-8">
      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p class="text-base font-medium tracking-wider text-muted-foreground">
            Shopify Workflow
          </p>
          <h1
            class="text-3xl leading-tight font-semibold tracking-wide sm:text-4xl lg:text-5xl"
          >
            Prep Shopify CSV imports without a spreadsheet detour.
          </h1>
          <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
            Start with the Shopify preset in FixMyImport when a product,
            customer, or catalog export needs cleanup before re-import.
          </p>
        </div>
        <div class="grid gap-4 text-base text-muted-foreground">
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-lg font-semibold tracking-wide text-foreground">
              Use the preset first
            </h2>
            <p class="mt-2 leading-relaxed">
              The Shopify preset defaults to size-aware splitting, repeated
              headers, and conservative batch settings that are easier to retry
              if an import goes wrong.
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-lg font-semibold tracking-wide text-foreground">
              Dedupe with identity columns
            </h2>
            <p class="mt-2 leading-relaxed">
              If your CSV includes email, handle, or SKU columns, select those
              first for deterministic dedupe instead of deduping by full row.
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-lg font-semibold tracking-wide text-foreground">
              Export small, predictable batches
            </h2>
            <p class="mt-2 leading-relaxed">
              ZIP export keeps multi-file downloads tidy while preserving the
              same header structure in every batch file.
            </p>
          </div>
        </div>
        <Button asChild>
          <a href="/tools/csv-import-cleaner">Open the CSV Import Cleaner</a>
        </Button>
      </div>
    </div>
  </main>
</Layout>

---
import ShopifyCleanerPage from "@/components/pages/shopify-cleaner-page.astro"
import { nonDefaultLangs, type Lang } from "@/i18n/ui"

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params as { lang: Lang }
---

<ShopifyCleanerPage lang={lang} />

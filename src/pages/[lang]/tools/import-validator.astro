---
import ComingSoonToolPage from "@/components/pages/coming-soon-tool-page.astro"
import { nonDefaultLangs, type Lang } from "@/i18n/ui"

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params as { lang: Lang }
---

<ComingSoonToolPage toolId="import-validator" lang={lang} />

---
import PrivacyPolicyPage from "@/components/pages/privacy-policy-page.astro"
import { nonDefaultLangs, type Lang } from "@/i18n/ui"

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params as { lang: Lang }
---

<PrivacyPolicyPage lang={lang} />

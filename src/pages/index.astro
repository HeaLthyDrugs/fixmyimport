---
import { RiArrowRightUpLine } from "@remixicon/react"

import Layout from "@/layouts/main.astro"
import ToolIcon from "@/components/tool-icon.astro"
import { toolCatalog } from "@/lib/tools"
---

<Layout
  title="FixMyImport | Browser-based tools for messy imports"
  description="Discover FixMyImport tools for cleaning, deduping, and splitting import files locally in your browser."
>
  <main class="px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mb-6">
        <h1
          class="text-left text-2xl font-semibold tracking-[-0.05em] sm:text-3xl"
        >
          Fix My Import
        </h1>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          toolCatalog.map((tool) => (
            <a
              href={tool.href}
              class="group flex min-h-40 flex-col border border-border/70 bg-background/88 p-4 shadow-[0_16px_40px_-34px_rgba(15,23,42,0.28)] transition duration-200 hover:-translate-y-0.5 hover:border-foreground/15"
            >
              <div class="mb-4 flex items-start justify-between gap-3">
                <div class="bg-primary/8 p-3 text-primary">
                  <ToolIcon name={tool.icon} className="size-8" />
                </div>
                <RiArrowRightUpLine className="size-4 text-muted-foreground transition group-hover:text-foreground" />
              </div>

              <div class="space-y-1.5">
                <h2 class="text-base font-semibold tracking-[-0.03em]">
                  {tool.name}
                </h2>
                <p class="text-sm leading-5 text-muted-foreground">
                  {tool.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</Layout>

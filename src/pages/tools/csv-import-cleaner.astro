---
import {
  RiArrowLeftLine,
  RiCheckboxCircleLine,
  RiFileZipLine,
  RiShieldCheckLine,
} from "@remixicon/react"

import { CsvWorkbench } from "@/components/csv-workbench"
import ToolIcon from "@/components/tool-icon.astro"
import Layout from "@/layouts/main.astro"
import { toolCatalog } from "@/lib/tools"

const tool = toolCatalog.find((item) => item.id === "csv-import-cleaner")

if (!tool) {
  throw new Error("CSV Import Cleaner metadata is missing.")
}

const highlights = [
  {
    title: "Clean with preview",
    description:
      "Open a CSV, inspect the processed output, and see what changes before you export.",
    icon: RiCheckboxCircleLine,
  },
  {
    title: "Split oversized files",
    description:
      "Create smaller, repeatable batches when an import target is strict about row or file size limits.",
    icon: RiFileZipLine,
  },
  {
    title: "Keep data local",
    description:
      "The default workflow runs in the browser, which keeps sensitive import prep off a server.",
    icon: RiShieldCheckLine,
  },
]
---

<Layout title={tool.seoTitle} description={tool.seoDescription}>
  <main class="px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 sm:gap-8">
      <a
        href="/"
        class="inline-flex w-fit items-center gap-2 text-sm text-muted-foreground transition hover:text-foreground"
      >
        <RiArrowLeftLine className="size-4" />
        All tools
      </a>

      <section
        class="overflow-hidden border border-border/70 bg-background/85 p-6 shadow-[0_20px_80px_-36px_rgba(20,24,28,0.2)] backdrop-blur sm:p-8"
      >
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:items-start">
          <div class="space-y-5">
            <div
              class="inline-flex items-center gap-3 border border-border/70 bg-background/80 px-3 py-1.5 text-sm"
            >
              <span
                class="inline-flex border border-border/70 bg-primary/8 p-2 text-primary"
              >
                <ToolIcon name={tool.icon} className="size-4" />
              </span>
              <span class="font-medium text-muted-foreground">
                {tool.status} tool
              </span>
            </div>

            <div class="max-w-3xl space-y-4">
              <h1 class="text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">
                {tool.name}
              </h1>
              <p class="max-w-2xl text-base leading-7 text-muted-foreground">
                {tool.description}
              </p>
            </div>
          </div>

          <div class="grid gap-3">
            {
              highlights.map((highlight) => {
                const Icon = highlight.icon

                return (
                  <div class="border border-border/70 bg-background/82 p-4">
                    <div class="flex items-start gap-3">
                      <span class="mt-0.5 text-primary">
                        <Icon className="size-5" />
                      </span>
                      <div class="space-y-1">
                        <h2 class="text-sm font-semibold">{highlight.title}</h2>
                        <p class="text-sm leading-6 text-muted-foreground">
                          {highlight.description}
                        </p>
                      </div>
                    </div>
                  </div>
                )
              })
            }
          </div>
        </div>
      </section>

      <section
        id="tool-app"
        class="border border-border/70 bg-background/90 p-3 shadow-[0_20px_60px_-40px_rgba(20,24,28,0.25)] sm:p-4"
      >
        <CsvWorkbench client:load />
      </section>
    </div>
  </main>
</Layout>

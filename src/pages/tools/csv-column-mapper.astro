---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import { toolCatalog } from "@/lib/tools"

const tool = toolCatalog.find((item) => item.id === "csv-column-mapper")

if (!tool) {
  throw new Error("CSV Column Mapper metadata is missing.")
}
---

<Layout title={tool.seoTitle} description={tool.seoDescription}>
  <main class="w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl p-6 sm:p-8">
      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p
            class="text-sm font-medium tracking-[0.14em] text-muted-foreground uppercase"
          >
            Coming soon
          </p>
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            Rename and reorder columns so your CSV fits the target system.
          </h1>
          <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
            Match columns from one format to another — rename headers, change the
            order, and drop what you don't need. All in the browser, nothing
            uploaded.
          </p>
        </div>
        <div class="grid gap-4 text-sm text-muted-foreground">
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-base font-semibold text-foreground">
              Map columns visually
            </h2>
            <p class="mt-2 leading-6">
              Pick a source column, choose what it should be called in the
              target, and see the result update instantly.
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-base font-semibold text-foreground">
              Save mapping templates
            </h2>
            <p class="mt-2 leading-6">
              Reuse the same column mapping next time instead of setting it up
              from scratch.
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-base font-semibold text-foreground">
              Drop columns you don't need
            </h2>
            <p class="mt-2 leading-6">
              Remove extra columns before exporting so the output file only has
              what the import expects.
            </p>
          </div>
        </div>
        <Button asChild>
          <a href="/tools/csv-import-cleaner">Try the CSV Import Cleaner instead</a>
        </Button>
      </div>
    </div>
  </main>
</Layout>

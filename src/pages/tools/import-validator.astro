---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import { toolCatalog } from "@/lib/tools"

const tool = toolCatalog.find((item) => item.id === "import-validator")

if (!tool) {
  throw new Error("Import Validator metadata is missing.")
}
---

<Layout title={tool.seoTitle} description={tool.seoDescription}>
  <main class="w-full px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl p-6 sm:p-8">
      <div class="max-w-3xl space-y-6">
        <div class="space-y-3">
          <p
            class="text-sm font-medium tracking-[0.14em] text-muted-foreground uppercase"
          >
            Coming soon
          </p>
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            Check if your CSV is ready to import — before you upload it.
          </h1>
          <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
            Pick a platform like Shopify or Mailchimp, upload your file, and get
            a quick report on what's missing, what's broken, and what might fail
            on import.
          </p>
        </div>
        <div class="grid gap-4 text-sm text-muted-foreground">
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-base font-semibold text-foreground">
              Check required columns
            </h2>
            <p class="mt-2 leading-6">
              See which columns the target platform expects and which ones are
              missing from your file.
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-base font-semibold text-foreground">
              Catch bad data early
            </h2>
            <p class="mt-2 leading-6">
              Find rows with invalid emails, empty required fields, or
              unexpected values before they cause import errors.
            </p>
          </div>
          <div class="border border-border/70 bg-background/70 p-4">
            <h2 class="text-base font-semibold text-foreground">
              File size and row limit check
            </h2>
            <p class="mt-2 leading-6">
              Know upfront if your file exceeds the platform's size or row
              limits so you can split it first.
            </p>
          </div>
        </div>
        <Button asChild>
          <a href="/tools/csv-import-cleaner"
            >Try the CSV Import Cleaner instead</a
          >
        </Button>
      </div>
    </div>
  </main>
</Layout>
